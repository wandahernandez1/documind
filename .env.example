# Copiá este archivo como .env y completá los valores.
# Nunca subas el .env a GitHub.

# --- Postgres (lo usa docker-compose) ---
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind

# --- API ---
PORT=3001
DATABASE_URL=postgresql://documind:documind@localhost:5432/documind
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000

# Generalos con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- IA (semana 3) ---
GEMINI_API_KEY=

# --- Almacenamiento de archivos (semana 2) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
